      "css": ".ds-identity{max-width:250px;color:#080b09;font-family:\"Roboto Variable\",sans-serif;font-size:18px;font-weight:700;line-height:1.4}.ds-identity summary{cursor:pointer;white-space:nowrap}.ds-identity summary:hover{text-decoration:underline}.ds-identity summary:focus-visible{outline:3px solid var(--focus,#507c39);outline-offset:3px;}.ds-identity code{display:block;min-width:180px;font-family:\"Roboto Variable\",sans-serif;font-size:13px;font-weight:400;line-height:1.5;user-select:all;overflow-wrap:anywhere;white-space:normal}.ds-identity small{display:block;margin-top:8px;color:#535653;font-size:12px;font-weight:400}"
